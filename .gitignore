# Entorno virtual
venv/
__pycache__/
*.pyc

# Archivos de configuración con tokens o credenciales sensibles
.env
config.json
config/config.json
OLD-config.json
*.token
config/*.token
config/.backup_golden/

# Logs de auditoría, anclajes y ejecución
*.log
audit/*.log
audit/*.txt
audit/*.html
audit/*.md
audit/*.pcap
audit/.sys_anchor
intentos_acceso.log
!audit/.gitkeep

# Documentación interna confidencial (Exclusiva del servidor local)
docs/
docs/*

