#!/usr/bin/env bash
# ==============================================================================
# 🔄 SISTEMA DE RESILIENCIA: rollback (@IA_ValleSeco_bot)
# Restauración Atómica de Estado Seguro y Autorrecuperación ante Cortes de Luz
# Ubicación: /opt/sonar/tools/rollback
# Sistema Objetivo: Debian 12 / 13 GNU/Linux (amd64) o Ubuntu Server
