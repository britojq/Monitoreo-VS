set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
BASE_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"
BASE_DIR="${BASE_DIR:-/opt/sonar}"
cd "$BASE_DIR"

CHECKPOINTS_DIR="$BASE_DIR/system/recovery/checkpoints"
PYTHON_EXEC="$BASE_DIR/venv/bin/python"

# Colores para salida interactiva
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
BOLD="\033[1m"
NC="\033[0m" # No Color

# ------------------------------------------------------------------------------
# 1. VERIFICACIÓN RÁPIDA DE INTEGRIDAD (< 50ms)
# ------------------------------------------------------------------------------
check_health() {
    # 1.1 Comprobar si existen archivos críticos con tamaño > 0
    for f in "bot.py"; do
        if [ ! -f "$BASE_DIR/$f" ] || [ ! -s "$BASE_DIR/$f" ]; then
            return 1
        fi
    done

    # 1.2 Comprobar compilación Python
    if [ -f "$PYTHON_EXEC" ]; then
        if ! "$PYTHON_EXEC" -m py_compile bot.py >/dev/null 2>&1; then
            return 2
        fi
    fi

    return 0
}

# ------------------------------------------------------------------------------
# 2. LIMPIEZA DE BLOQUEOS HUÉRFANOS DE GIT (POR APAGÓN REPENTINO)
# ------------------------------------------------------------------------------
cleanup_git_locks() {
    if [ -f "$BASE_DIR/.git/index.lock" ]; then
        rm -f "$BASE_DIR/.git/index.lock"
    fi
}

# ------------------------------------------------------------------------------
# 3. RESTAURACIÓN DE UN CHECKPOINT
# ------------------------------------------------------------------------------
restore_checkpoint() {
    local target_id="${1:-""}"
    local is_auto="${2:-0}"
    local target_path=""
    local desc="Último estado funcional conocido"

    cleanup_git_locks

    # Determinar carpeta de origen
    if [ -n "$target_id" ]; then
        target_path="$CHECKPOINTS_DIR/$target_id"
        if [ ! -d "$target_path" ]; then
            echo -e "${RED}[ERROR] El checkpoint "$target_id" no existe.${NC}" >&2
            return 1
        fi
    elif [ -f "$CHECKPOINTS_DIR/LATEST" ]; then
        latest_id=$(cat "$CHECKPOINTS_DIR/LATEST" | tr -d "[:space:]")
        if [ -n "$latest_id" ] && [ -d "$CHECKPOINTS_DIR/$latest_id" ]; then
            target_path="$CHECKPOINTS_DIR/$latest_id"
            target_id="$latest_id"
        fi
    fi

    if [ $is_auto -eq 0 ]; then
        echo -e "${CYAN}=================================================================${NC}"
        echo -e "${BOLD}🔄 INICIANDO RESTAURACIÓN DE SEGURIDAD (ROLLBACK)${NC}"
        echo -e "${CYAN}=================================================================${NC}"
    fi

    # 1. Restaurar código base vía Git
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if [ $is_auto -eq 0 ]; then
            echo -e "📦 Restaurando archivos del repositorio Git..."
        fi
        git reset --hard HEAD >/dev/null 2>&1 || true
        # Limpiar archivos no rastreados sin tocar .env ni la bóveda física
        git clean -fd -e ".env" -e "web_portal/.env" -e "system/vault" >/dev/null 2>&1 || true
    fi

    # 2. Restaurar metadatos desde el Checkpoint
    if [ -n "$target_path" ] && [ -d "$target_path" ]; then
        if [ $is_auto -eq 0 ]; then
            echo -e "⚙️  Restaurando desde checkpoint ${CYAN}[$target_id]${NC}..."
        fi
        if [ -f "$target_path/metadata.json" ] && command -v jq >/dev/null 2>&1; then
            desc=$(jq -r ".description // \"Sin descripción\"" "$target_path/metadata.json")
        fi
    fi

    # 3. Forzar escritura a disco
    sync

    # 4. Validar integridad resultante
    if ! check_health; then
        if [ $is_auto -eq 0 ]; then
            echo -e "${RED}[ERROR CRÍTICO] La restauración no pudo dejar los archivos en un estado sintáctico válido.${NC}" >&2
        fi
        return 1
    fi

    # 5. Registrar en auditoría MariaDB audit_logs (SSOT)
    TIPO_RB=$( [ $is_auto -eq 1 ] && echo "AUTONOMO_AUTO" || echo "MANUAL" )
    if [ -f "$BASE_DIR/web_portal/artisan" ]; then
        php "$BASE_DIR/web_portal/artisan" audit:record \
            --event="ROLLBACK_EXECUTED" \
            --module="system" \
            --description="Rollback $TIPO_RB hacia checkpoint: $target_id ($desc)" >/dev/null 2>&1 || true
    fi

    # 6. Si fue automático, registrar bandera en MariaDB bot_settings (SSOT - Cero archivos planos)
    if [ $is_auto -eq 1 ]; then
        if [ -x "$PYTHON_EXEC" ]; then
            "$PYTHON_EXEC" -c "from bot_core.services.config_manager import set_auto_rollback_notice; set_auto_rollback_notice('$target_id', '$desc', '$NOW_STR')" >/dev/null 2>&1 || true
        fi
    fi

    # 7. Reiniciar servicio si se ejecuta interactivamente
    if [ $is_auto -eq 0 ]; then
        echo -e "🚀 Reiniciando servicio ${BOLD}tg-admin-bot.service${NC}..."
        if command -v systemctl >/dev/null 2>&1; then
            sudo systemctl restart tg-admin-bot.service >/dev/null 2>&1 || systemctl restart tg-admin-bot.service >/dev/null 2>&1 || true
            sleep 1
            if systemctl is-active --quiet tg-admin-bot.service 2>/dev/null; then
                echo -e "${GREEN}✅ Servicio tg-admin-bot activo y funcionando al 100%.${NC}"
            else
                echo -e "${YELLOW}⚠️ Servicio reiniciado. Verifique el estado con: sudo systemctl status tg-admin-bot${NC}"
            fi
        fi

        echo -e "${GREEN}=================================================================${NC}"
        echo -e "${GREEN}✅ RESTAURACIÓN COMPLETADA CON ÉXITO${NC}"
        echo -e "   🆔 Checkpoint aplicado: ${CYAN}$target_id${NC}"
        echo -e "   📝 Descripción:         $desc"
        echo -e "   🛡️ Estado del sistema:   ${GREEN}Operativo y Libre de Errores${NC}"
        echo -e "${GREEN}=================================================================${NC}"
    fi

    return 0
}

# ------------------------------------------------------------------------------
# 4. PRE-START CHECK DE SYSTEMD (AUTORRECUPERACIÓN AUTÓNOMA)
# ------------------------------------------------------------------------------
pre_start_check() {
    if check_health; then
        exit 0
    fi

    # Detectada falla o corrupción: disparar auto-rollback
    NOW_STR=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[$NOW_STR] [ALERTA PRE-START] Archivos corruptos o rotos detectados en arranque. Ejecutando Auto-Rollback..." >> "$AUDIT_LOG"
    
    if restore_checkpoint "" 1; then
        echo "[$NOW_STR] [PRE-START] Auto-Rollback completado exitosamente. Continuando arranque del bot..." >> "$AUDIT_LOG"
        exit 0
    else
        echo "[$NOW_STR] [ERROR FATAL] Falló el Auto-Rollback en pre-start." >> "$AUDIT_LOG"
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# 5. ENTRADA PRINCIPAL
# ------------------------------------------------------------------------------
case "${1:-}" in
    --pre-start-check)
        pre_start_check
        ;;
    -l|--list|list)
        if [ -f "$BASE_DIR/checkpoint" ]; then
            "$BASE_DIR/checkpoint" --list
        else
            echo "Directorio de checkpoints: $CHECKPOINTS_DIR"
            ls -la "$CHECKPOINTS_DIR"
        fi
        ;;
    -t|--to)
        if [ -z "${2:-}" ]; then
            echo -e "${RED}[ERROR] Debe especificar el ID del checkpoint. Ejemplo: rollback --to 20260828_094701${NC}" >&2
            exit 1
        fi
        restore_checkpoint "$2" 0
        ;;
    -c|--check|check)
        echo -e "${CYAN}🔍 Verificando integridad sintáctica y física del proyecto...${NC}"
        if check_health; then
            echo -e "${GREEN}✅ Todos los archivos críticos, sintaxis de Python y JSON son 100% válidos.${NC}"
        else
            echo -e "${RED}❌ Se detectaron fallas de sintaxis o archivos vacíos/corruptos.${NC}"
            echo -e "   Ejecute ${YELLOW}rollback${NC} para restaurar el sistema."
            exit 1
        fi
        ;;
    -g|--git)
        echo -e "${YELLOW}Forzando reseteo a último commit de Git...${NC}"
        cleanup_git_locks
        git reset --hard HEAD
        git clean -fd -e ".env" -e "web_portal/.env" -e "system/vault"
        sync
        echo -e "${GREEN}✅ Git reseteado al estado del último commit.${NC}"
        ;;
    -h|--help|help)
        echo "Uso: rollback [OPCIÓN]"
        echo ""
        echo "Comandos y Opciones:"
        echo "  (sin argumentos)    Restaura de inmediato al último checkpoint funcional y reinicia el bot."
        echo "  --to <ID>, -t <ID>  Restaura al ID de checkpoint especificado (Ver lista con --list)."
        echo "  --list, -l          Muestra todos los checkpoints históricos disponibles."
        echo "  --check, -c         Verifica la salud de los archivos del bot sin modificarlos."
        echo "  --git, -g           Restaura el árbol de trabajo al último commit de Git."
        echo "  --help, -h          Muestra esta ayuda."
        ;;
    *)
        restore_checkpoint "" 0
        ;;
esac
