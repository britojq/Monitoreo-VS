## ARCHIVO DE CONFIGURACION DE LOS MENSAJES QUE SE ENVIAN AL BOT


##### DATOS PARA LA FECHA Y HORA
### NO MODIFICAR ESTAS LINEAS
#fecha=$(date '+ %A, %d %B , %Y.')
#hora=$(date '+ %H:%M:%S')
#fecha=$(date '+ %d/%m/%Y')
#hora=$(date '+ %H:%M:%S')


TZ_FIJA=''

if [ -n "$TZ_FIJA" ]; then
    datos=$(TZ="$TZ_FIJA" date '+%w|%d|%m|%Y|%H:%M:%S')
else
    datos=$(date '+%w|%d|%m|%Y|%H:%M:%S')
fi

IFS='|' read -r dia_semana dia_numero mes_numero anio hora <<EOF
$datos
EOF

dia_numero=${dia_numero#0}

case "$dia_semana" in
    0) dia_nombre="domingo" ;;
    1) dia_nombre="lunes" ;;
    2) dia_nombre="martes" ;;
    3) dia_nombre="miércoles" ;;
    4) dia_nombre="jueves" ;;
    5) dia_nombre="viernes" ;;
    6) dia_nombre="sábado" ;;
esac

case "$mes_numero" in
    01) mes_nombre="enero" ;;
    02) mes_nombre="febrero" ;;
    03) mes_nombre="marzo" ;;
    04) mes_nombre="abril" ;;
    05) mes_nombre="mayo" ;;
    06) mes_nombre="junio" ;;
    07) mes_nombre="julio" ;;
    08) mes_nombre="agosto" ;;
    09) mes_nombre="septiembre" ;;
    10) mes_nombre="octubre" ;;
    11) mes_nombre="noviembre" ;;
    12) mes_nombre="diciembre" ;;
esac

fecha="${dia_nombre^}, $dia_numero de ${mes_nombre^} de $anio."

#echo "$fecha"
#echo "$hora"


